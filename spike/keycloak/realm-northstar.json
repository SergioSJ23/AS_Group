{
  "realm": "northstar",
  "enabled": true,
  "displayName": "Northstar Living Group",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "groups": [
    {
      "name": "verified-customer",
      "path": "/verified-customer"
    }
  ],
  "roles": {
    "client": {
      "bu1-nopcommerce": [
        {
          "name": "HomeStyle-VIP",
          "description": "BU1-only customer role (HomeStyle premium B2C)",
          "clientRole": true
        }
      ],
      "bu2-nopcommerce": [
        {
          "name": "WorkSpace-Wholesale",
          "description": "BU2-only customer role (WorkSpace B2B wholesale)",
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "bu1-nopcommerce",
      "name": "BU1 HomeStyle nopCommerce",
      "enabled": true,
      "publicClient": false,
      "secret": "bu1-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://bu1.localtest.me:8081/*",
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "http://bu1.localtest.me:8081",
        "http://localhost:8081"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://bu1.localtest.me:8081/*"
      },
      "protocolMappers": [
        {
          "name": "bu-client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "bu_roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "bu1-nopcommerce",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bu2-nopcommerce",
      "name": "BU2 WorkSpace nopCommerce",
      "enabled": true,
      "publicClient": false,
      "secret": "bu2-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://bu2.localtest.me:8082/*",
        "http://localhost:8082/*"
      ],
      "webOrigins": [
        "http://bu2.localtest.me:8082",
        "http://localhost:8082"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://bu2.localtest.me:8082/*"
      },
      "protocolMappers": [
        {
          "name": "bu-client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "bu_roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "bu2-nopcommerce",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Northstar",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/verified-customer"],
      "clientRoles": {
        "bu1-nopcommerce": ["HomeStyle-VIP"],
        "bu2-nopcommerce": ["WorkSpace-Wholesale"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ]
    }
  ]
}
