      "panels": [],
      "title": "ADR-003 — Transactional outbox → RabbitMQ → CRM",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "id": 1,
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "outbox_unpublished_rows", "legendFormat": "{{bu}} unpublished", "refId": "A"}
      ],
      "title": "Outbox backlog (unpublished rows)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "id": 2,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(outbox_publish_latency_ms_milliseconds_bucket[1m])))", "legendFormat": "p95", "refId": "A"},
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(outbox_publish_latency_ms_milliseconds_bucket[1m])))", "legendFormat": "p50", "refId": "B"}
      ],
      "title": "Outbox publish latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "id": 3,
      "targets": [
        {"expr": "rate(outbox_published_total[1m])", "legendFormat": "{{bu}} published/s", "refId": "A"},
        {"expr": "rate(outbox_publish_failures_total[1m])", "legendFormat": "{{bu}} failed/s", "refId": "B"},
        {"expr": "rabbitmq_queue_messages{queue=\"northstar.crm.orders\"}", "legendFormat": "rabbit queue depth", "refId": "C"}
      ],
      "title": "Publish rate + RabbitMQ queue depth",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 200,
      "panels": [],
      "title": "ADR-004 — ERP circuit breaker",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}, "1": {"text": "HALF-OPEN", "color": "yellow"}, "2": {"text": "OPEN", "color": "red"}}}
          ]
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 10},
      "id": 4,
      "options": {"colorMode": "background"},
      "targets": [
        {"expr": "erp_breaker_state", "legendFormat": "{{bu}}", "refId": "A"}
      ],
      "title": "Breaker state (0=closed, 1=half, 2=open)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 10},
      "id": 5,
      "targets": [
        {"expr": "increase(erp_breaker_transitions_total[5m])", "legendFormat": "{{bu}} → {{state}}", "refId": "A"}
      ],
      "title": "Breaker transitions (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 10},
      "id": 6,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(erp_call_duration_ms_milliseconds_bucket[1m])))", "legendFormat": "p95 {{outcome}}", "refId": "A"},
        {"expr": "rate(erp_cache_serve_total[1m])", "legendFormat": "cache serves/s ({{reason}})", "refId": "B"}
      ],
      "title": "ERP call duration p95 + cache fallback rate",
      "type": "timeseries"
    },

