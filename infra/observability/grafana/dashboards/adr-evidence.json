      },
      "id": 50,
      "panels": [],
      "title": "ADR-001 — Per-BU process and data isolation",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bu1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "BU1 (HomeStyle)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bu2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "BU2 (WorkSpace)"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 51,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (bu) (rate(http_server_request_duration_seconds_count{job=\"nopcommerce\", http_response_status_code=~\"2..\", http_route=~\"/.*\", http_route!=\"/metrics\"}[1m]))",
          "legendFormat": "{{bu}}",
          "refId": "A"
        }
      ],
      "title": "Storefront requests served per BU (HTTP 2xx/s) — data isolation proof",
      "description": "Rate of successfully served storefront requests (HTTP 2xx, excluding the /metrics scrape) per BU, from the nopCommerce HTTP server metrics. During the ADR-001 isolation demo (docker compose stop db_bu1) BU1 can no longer serve pages so its line drops to 0, while BU2 keeps serving requests normally — proving the BUs are isolated.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bu1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2495C",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "BU1 (HomeStyle)"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#F2495C",
                      "value": null
                    },
                    {
                      "color": "#73BF69",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bu2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "BU2 (WorkSpace)"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 52,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "pg_up",
          "legendFormat": "{{bu}}",
          "refId": "A"
        }
      ],
      "title": "Per-BU database availability (1 = DB responding, 0 = DB down)",
      "description": "pg_up from a postgres-exporter attached to each BU database. 1 = the BU's PostgreSQL answered a query on the last scrape, 0 = it did not. During the ADR-001 isolation demo (docker compose stop db_bu1) the BU1 line drops from 1 to 0 while BU2 stays at 1, then recovers to 1 when the database is restarted. The exporter process stays up throughout, so the line shows a clean 0 rather than going to 'No data'.",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 100,
      "panels": [],
      "title": "ADR-003 — Transactional outbox → RabbitMQ → CRM",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (bu) (outbox_unpublished_rows) or sum by (bu) (outbox_unpublished_rows * 0 + 0)",
          "legendFormat": "{{bu}} unpublished",
          "refId": "A"
        }
      ],
      "title": "Outbox backlog (unpublished rows)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, bu) (rate(outbox_publish_latency_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p95 {{bu}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, bu) (rate(outbox_publish_latency_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p50 {{bu}}",
          "refId": "B"
        }
      ],
      "title": "Outbox publish latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 3,
      "targets": [
        {
          "expr": "rate(outbox_published_total[1m])",
          "legendFormat": "{{bu}} published/s",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_queue_messages{queue=\"northstar.crm.orders\"}",
          "legendFormat": "RabbitMQ queue depth",
          "refId": "B"
        }
      ],
      "title": "Publish rate + RabbitMQ queue depth",
      "type": "timeseries",
      "description": "Outbox relay publish rate per BU and RabbitMQ queue depth. Queue depth spikes when CRM consumer is down — drains on recovery."
    },
    {
