      "title": "ADR-004 — ERP circuit breaker",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green"
                },
                "1": {
                  "text": "HALF-OPEN",
                  "color": "yellow"
                },
                "2": {
                  "text": "OPEN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "id": 4,
      "options": {
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "erp_breaker_state",
          "legendFormat": "{{bu}}",
          "refId": "A"
        }
      ],
      "title": "Breaker state (0=closed, 1=half, 2=open)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "id": 5,
      "targets": [
        {
          "expr": "erp_breaker_state",
          "legendFormat": "{{bu}}",
          "refId": "A"
        }
      ],
      "title": "Breaker state over time (0=closed, 1=half-open, 2=open)",
      "type": "timeseries",
      "description": "State timeline per BU. Line goes 0→2 when ERP fails (OPEN), 2→1 after cooldown (HALF-OPEN probe), 1→0 when probe succeeds (CLOSED).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "fillOpacity": 10
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green"
                },
                "1": {
                  "text": "HALF-OPEN",
                  "color": "orange"
                },
                "2": {
                  "text": "OPEN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bu1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bu2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2495C",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(erp_call_duration_ms_milliseconds_bucket{outcome=\"live\"}[1m])))",
          "legendFormat": "p95 live",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(erp_call_duration_ms_milliseconds_bucket{outcome=\"short-circuit-cache\"}[1m])))",
          "legendFormat": "p95 short-circuit-cache",
          "refId": "B"
        },
        {
          "expr": "rate(erp_cache_serve_total{reason=\"breaker-open\"}[1m])",
