@model Nop.Plugin.ExternalAuth.Keycloak.Models.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="KeycloakAuthentication" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <p>
                        Configure the Keycloak OIDC connection for this BU. The Authority URL is the Keycloak realm URL,
                        e.g. <code>http://keycloak.localtest.me:8080/realms/northstar</code>.
                        The redirect URI to register in Keycloak is: <code>@webHelper.GetStoreLocation()signin-keycloak</code>
                    </p>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Authority" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Authority" />
                            <span asp-validation-for="Authority"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="ClientId" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ClientId" />
                            <span asp-validation-for="ClientId"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="ClientSecret" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ClientSecret" />
                            <span asp-validation-for="ClientSecret"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
